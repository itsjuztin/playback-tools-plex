{
  "manifest_version": 3,
  "name": "Playback Tools for Plex",
  "version": "1.0.1",
  "description": "Silent auto-skip for intros and credits, countdown bypass, Picture-in-Picture, and speed controls for Plex.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://app.plex.tv/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.plex.tv/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["src/content/plex_enhancer.js"],
      "css": ["src/content/plex_enhancer.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Playback Tools for Plex"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
